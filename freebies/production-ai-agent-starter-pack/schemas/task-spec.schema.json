{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/task-spec.schema.json",
  "title": "Coding Agent Task Specification",
  "description": "A practical schema for making coding-agent requests explicit before implementation. Replace the example.invalid identifier when publishing this schema independently.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal",
    "scope",
    "acceptanceCriteria",
    "testPlan"
  ],
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "Observable outcome the change should deliver."
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inScope", "outOfScope"],
      "properties": {
        "inScope": {
          "type": "array",
          "items": { "type": "string" }
        },
        "outOfScope": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "required": { "type": "boolean", "default": true },
          "constraints": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "constraints": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": { "type": "string" }
    },
    "failureBehavior": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "given", "when", "then"],
        "properties": {
          "id": { "type": "string" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" }
        }
      }
    },
    "testPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "testType", "description"],
        "properties": {
          "criterionId": { "type": "string" },
          "testType": {
            "type": "string",
            "enum": ["unit", "integration", "contract", "end-to-end", "manual"]
          },
          "description": { "type": "string" },
          "command": { "type": "string" }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
